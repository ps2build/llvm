# RUN: llc -mtriple=mips64r5900el-ps2-elf -run-pass=postrapseudos -o - %s | FileCheck %s
---
name: mmi128
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $a0, $ra_64, $gpr128_6, $gpr128_7, $gpr128_9, $gpr128_10
    ; CHECK-LABEL: name: mmi128
    ; CHECK: $a1_64 = P_PAND $a2_64, $a3_64
    ; CHECK: $t0_64 = P_PADDW $t1_64, $t2_64
    ; CHECK: $t3_64 = LQ $a0, 16
    ; CHECK: SQ $t3_64, $a0, 32
    $gpr128_5 = PAND_128 $gpr128_6, $gpr128_7
    $gpr128_8 = PADDW_128 $gpr128_9, $gpr128_10
    $gpr128_11 = LQ_128 $a0, 16
    SQ_128 $gpr128_11, $a0, 32
    PseudoReturn64 $ra_64
...
